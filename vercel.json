{
  "version": 2,
  "installCommand": "npm ci && cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "devCommand": "npm run dev",
  "regions": ["sin1"],
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "/api/index.js"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.js"
    }
  ]
}

